{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SQL: construir y comprobar",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "SQL: verificar desde cero",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1",
        "-Verify"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}